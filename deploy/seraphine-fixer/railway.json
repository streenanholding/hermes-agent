{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["deploy/seraphine-fixer/src/**", "deploy/seraphine-fixer/Dockerfile", "deploy/seraphine-fixer/railway.json"]
  },
  "deploy": {
    "startCommand": "bun src/main.ts",
    "healthcheckPath": "/health",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
